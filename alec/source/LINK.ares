$ @mod LINK

# \file LINK.ares
# \info The linker: translation units in, one WebAssembly module out. alec
#       compiles every input (and its C library) in one run, so linking is a
#       pass over typed trees rather than object files:
#         1. merge the units' functions, globals and prototypes, checking for
#            multiple definitions;
#         2. keep what is reachable from the entry point, so the C library
#            costs only what a program uses;
#         3. functions declared but defined nowhere become imports from the
#            host's `env` module (that is the FFI: a C prototype is enough);
#         4. lay out the data, then the shadow stack, then the heap;
#         5. generate each function and assemble the module.

$ @import ARESxALGO
$ @import LEX
$ @import DIAG
$ @import TYPE
$ @import AST
$ @import CFG
$ @import WASM
$ @import GEN
$ @import PARSE
$ @import ARESxOPT
$ @import ARESxMAP
$ @import ARESxSET
$ @import ARESxBITS
$ @import ARESxLIST
$ @import ARESxVEC
$ @import ARESxSTR

$ stack_size : @Int = 1048576
$ data_base : @Int = 1024

# The C library's entry point calls this, and the linker writes it: it calls
# `main` with whichever parameters `main` was declared to take.
$ main_shim : @Str = "__alec_main"

$ link : Target -> @Str -> @Vec TU -> <Diag> @Str = \tg entry tus =>
    let lay = Layout.{ .target = tg, .aggs = merge_aggs tus } in
    let funcs = collect_funcs tus 0 0 (new {}) in
    let globals = collect_globals tus 0 0 (new {}) in
    let protos =
        foldl (\m tu =>
            fold (\acc k v => if has k acc => acc else ARES.insert k v acc) m tu.protos)
            (new {}) tus
    in
    (
        if !(has entry funcs) =>
            error_at nowhere ("undefined reference to '" ++ entry ++ "' (the entry point)")
        else
            {}
    );
    let frefs =
        foldl (\m tu => foldl (\m2 f => ARES.insert f.name (func_refs tu f) m2) m tu.funcs)
            (new {}) tus
    in
    let live = reach frefs globals (ARES.singleton entry) (new {}) in
    let defined = filter (\f => has f.name live) (ARES.values funcs) in
    let ordered = ARES.sort_by (\a b => ARES.cmp_str a.name b.name) defined in
    let imports = filter (\n =>
        !(has n funcs)
            && !(has n globals)
            && is_none (GEN.intrinsic n)
            && n != main_shim
            && n != "__heap_base"
            && n != "alloca") (to_list live) in
    let shim = has main_shim live in
    check_vars imports protos;
    let gvars = filter (\g => has g.name live) (ARES.values globals) in
    let placed = place lay gvars 0 data_base (new {}) (@vec_new {}) in
    let data_end = placed.0 in
    let stack_top = align_to (data_end + stack_size) 16 in
    let addrs = ARES.insert "__heap_base" stack_top placed.1 in
    let ni = @vec_len imports in
    let fidx0 = foldl (\m n => ARES.insert n (len m) m) (new {}) imports in
    let fidx1 = foldl (\m f => ARES.insert f.name (len m) m) fidx0 ordered in
    let fidx = if shim => ARES.insert main_shim (len fidx1) fidx1 else fidx1 in
    let table_names = append (fmap (\f => f.name) ordered) imports in
    let tidx = foldl (\m n => ARES.insert n (len m + 1) m) (new {}) table_names in
    let ftys0 =
        fold (\m k t => fn_of t |> \ | Opt.Some.{ ft } => ARES.insert k ft m | _ => m)
            (new {}) protos
    in
    let ftys = foldl (\m f => ARES.insert f.name f.ty m) ftys0 ordered in
    let ctx = Ctx.{
        .lay = lay,
        .tg = tg,
        .addrs = addrs,
        .fidx = fidx,
        .tidx = tidx,
        .ftys = ftys,
        .heap = stack_top
    } in
    let imp =
        foldl (\acc n =>
            let ft = unwrap_or (FnTy.{ .ret = t_int, .params = List.Nil, .variadic = @false, .proto = @false })
                (get n ftys) in
            let r = type_index acc.1 (sig_of tg ft) in
            { @vec_push acc.0 Import.{ .module = "env", .name = n, .type = r.0 }, r.1 }) {
            @vec_new {},
            empty_types
        } imports
    in
    let gen = gen_all ctx ordered 0 (@vec_new {}) (@vec_new {}) imp.1 in
    let with_shim = if shim => add_shim ctx ftys gen else gen in
    let pages = (stack_top + 65536 + 65535) / 65536 in
    let m = Module.{
        .types = with_shim.2.sigs,
        .imports = imp.0,
        .funcs = with_shim.1,
        .table = fmap (\n => unwrap_or 0 (get n fidx)) table_names,
        .pages = pages,
        .mem64 = tg.wasm64,
        .globals = [
            Global.{
                .vt = ptr_vt tg,
                .mutable = @true,
                .init = (if tg.wasm64 => i64_const stack_top else i32_const stack_top)
            }
        ],
        .exports = [
            Export.{ .name = "memory", .kind = 2, .index = 0 },
            Export.{ .name = entry, .kind = 0, .index = unwrap_or 0 (get entry fidx) }
        ],
        .bodies = with_shim.0,
        .data = filter_map (\g => data_of ctx g) gvars,
        .names = append (if shim => [main_shim] else @vec_new {}) table_names
    } in
    encode m

# The names a set of units uses but none of them defines: what is still to
# be found in the C library (or left to the host as imports).
$ undefined : @Vec TU -> Set @Str = \tus =>
    let defined =
        foldl (\acc tu =>
            foldl (\a g => if g.defined || g.init => ARES.add g.name a else a)
                (foldl (\a f => ARES.add f.name a) acc tu.funcs) tu.globals) (new {}) tus
    in
    let used =
        foldl (\acc tu =>
            foldl (\a g => foldl (\b r => ARES.add r.sym b) a g.relocs)
                (
                    foldl (\a f => foldl (\b n => ARES.add n b) a (func_refs tu f)) acc
                        tu.funcs
                ) tu.globals) (new {}) tus
    in
    filter (\n => !(has n defined)) used

# The names `f`'s body refers to.
$ func_refs : TU -> Func -> List @Str = \tu f =>
    get f.name tu.refs |> \ | Opt.Some.{ r } => r | _ => refs_stmt f.body List.Nil

# The externally visible names a unit defines, for the library index.
$ exports : TU -> @Vec @Str = \tu =>
    append
        (
            filter_map (\g =>
                if g.static || !(g.defined || g.init) => Opt.None else Opt.Some.{ g.name })
                tu.globals
        )
        (filter_map (\f => if f.static => Opt.None else Opt.Some.{ f.name }) tu.funcs)

$ @private

# Each unit numbers its aggregates from its own base (see PARSE.with_tab), so
# their tables merge into one without collisions.
$ merge_aggs : @Vec TU -> Map @Int Agg = \tus => merge_aggs_go tus 0 (new {})

$ merge_aggs_go : @Vec TU -> @Int -> Map @Int Agg -> Map @Int Agg = \tus i acc =>
    if i >= @vec_len tus =>
        acc
    else
        merge_aggs_go tus (i + 1)
            (fold (\m k v => ARES.insert k v m) acc (@vec_get tus i).layout.aggs)

$ collect_funcs : @Vec TU -> @Int -> @Int -> Map @Str Func -> <Diag> Map @Str Func = \tus i j acc =>
    if i >= @vec_len tus =>
        acc
    else
        let fs = (@vec_get tus i).funcs in
        if j >= @vec_len fs =>
            collect_funcs tus (i + 1) 0 acc
        else
            let f = @vec_get fs j in
            if has f.name acc =>
                error_at f.pos ("multiple definition of '" ++ f.name ++ "'")
            else
                collect_funcs tus i (j + 1) (ARES.insert f.name f acc)

$ collect_globals : @Vec TU -> @Int -> @Int -> Map @Str GVar
    -> <Diag> Map @Str GVar = \tus i j acc =>
    if i >= @vec_len tus =>
        acc
    else
        let gs = (@vec_get tus i).globals in
        if j >= @vec_len gs =>
            collect_globals tus (i + 1) 0 acc
        else
            let g = @vec_get gs j in
            let merged = (
                get g.name acc |> \
                    | Opt.Some.{ old } =>
                        if old.init && g.init =>
                            error_at g.pos ("multiple definition of '" ++ g.name ++ "'")
                        else if g.init =>
                            g
                        else if old.init =>
                            old
                        else if g.defined && !old.defined =>
                            g
                        else if array_len old.ty < 0 && array_len g.ty >= 0 =>
                            GVar.{ .ty = g.ty | old }
                        else
                            old
                    | _ => g
            ) in
            collect_globals tus i (j + 1) (ARES.insert g.name merged acc)

# A variable used but defined nowhere has no import to become.
$ check_vars : @Vec @Str -> Map @Str Ty -> <Diag> {} = \names protos => for names (\n =>
    if has n protos => {} else error_at nowhere ("undefined reference to '" ++ n ++ "'"))

# -- reachability -------------------------------------------------------------------

$ reach : Map @Str (List @Str) -> Map @Str GVar -> List @Str -> Set @Str
    -> Set @Str = \frefs globals work seen =>
    work |> \
        | List.Nil => seen
        | List.Cons.{ n, rest } =>
            if has n seen =>
                reach frefs globals rest seen
            else
                let seen2 = ARES.add n seen in
                let more = (
                    get n frefs |> \
                        | Opt.Some.{ r } => r
                        | _                 => (
                            get n globals |> \
                                | Opt.Some.{ g } =>
                                    foldl (\acc r => List.Cons.{ r.sym, acc }) List.Nil g.relocs
                                | _                 =>
                                    if n == main_shim => ARES.singleton "main" else List.Nil
                        )
                ) in
                reach frefs globals (append rest more) seen2

$ refs_stmt : Stmt -> List @Str -> List @Str = \s acc =>
    s |> \
        | Stmt.Do.{ e }            => refs e acc
        | Stmt.Block.{ ss }        => foldl (\a x => refs_stmt x a) acc ss
        | Stmt.If.{ c, a, b }      => refs_stmt b (refs_stmt a (refs c acc))
        | Stmt.While.{ c, b }      => refs_stmt b (refs c acc)
        | Stmt.DoWhile.{ b, c }    => refs c (refs_stmt b acc)
        | Stmt.For.{ i, c, st, b } => refs_stmt b (refs st (refs c (refs_stmt i acc)))
        | Stmt.Switch.{ e, b }     => refs_stmt b (refs e acc)
        | Stmt.Case.{ lo, hi, b }  => refs_stmt b acc
        | Stmt.Default.{ b }       => refs_stmt b acc
        | Stmt.Label.{ l, b }      => refs_stmt b acc
        | Stmt.Return.{ e }        => refs e acc
        | Stmt.Jump.{ e, cs, d }   => refs e acc
        | Stmt.GotoPtr.{ e }       => refs e acc
        | _                        => acc

$ refs : Expr -> List @Str -> List @Str = \e acc =>
    e.e |> \
        | ENode.Global.{ g }            => List.Cons.{ g, acc }
        | ENode.Unary.{ o, x }          => refs x acc
        | ENode.Bin.{ o, a, b }         => refs b (refs a acc)
        | ENode.Assign.{ a, b }         => refs b (refs a acc)
        | ENode.OpAssign.{ o, a, b, t } => refs b (refs a acc)
        | ENode.PostOp.{ o, a, b }      => refs b (refs a acc)
        | ENode.Cond.{ c, a, b }        => refs b (refs a (refs c acc))
        | ENode.Comma.{ a, b }          => refs b (refs a acc)
        | ENode.Call.{ f, args, ft }    => foldl (\a x => refs x a) (refs f acc) args
        | ENode.Field.{ x, m }          => refs x acc
        | ENode.Deref.{ x }             => refs x acc
        | ENode.Addr.{ x }              => refs x acc
        | ENode.Cast.{ x }              => refs x acc
        | ENode.Zero.{ x, n }           => refs x acc
        | ENode.Copy.{ a, b, n }        => refs b (refs a acc)
        | ENode.Alloca.{ x }            => refs x acc
        | ENode.VaStart.{ x }           => refs x acc
        | ENode.VaArg.{ x }             => refs x acc
        | ENode.SExpr.{ ss, x }         => refs x (foldl (\a s => refs_stmt s a) acc ss)
        | _                             => acc

# -- data layout ----------------------------------------------------------------------

$ place : Layout -> @Vec GVar -> @Int -> @Int -> Map @Str @Int -> @Vec GVar
    -> { @Int, Map @Str @Int } = \lay gs i at addrs acc =>
    if i >= @vec_len gs =>
        { at, addrs }
    else
        let g = @vec_get gs i in
        let al =
            if g.align > 0 => g.align else (let a = align_of lay g.ty in if a < 1 => 1 else a)
        in
        let sz0 = size_of lay g.ty in
        let sz = if g.init && @array_len g.data > sz0 => @array_len g.data else sz0 in
        let start = align_to at al in
        place lay gs (i + 1) (start + (if sz < 1 => 1 else sz)) (ARES.insert g.name start addrs) acc

$ data_of : Ctx -> GVar -> Opt Data = \c g =>
    if !g.init =>
        Opt.None
    else
        let base = unwrap_or 0 (get g.name c.addrs) in
        let bytes =
            foldl (\b r =>
                let v =
                    (
                        get r.sym c.addrs |>
                            \ | Opt.Some.{ a } => a | _ => unwrap_or 0 (get r.sym c.tidx)
                    ) + r.addend
                in
                patch b r.offset c.tg.ptr v) g.data g.relocs
        in
        if all_zero bytes 0 =>
            Opt.None
        else
            Opt.Some.{ Data.{ .offset = base, .bytes = bytes } }

$ patch : @Str -> @Int -> @Int -> @Int -> @Str = \b off n v =>
    if n <= 0 => b else patch (@array_set b off (band v 255)) (off + 1) (n - 1) (shr_u v 8)

$ all_zero : @Str -> @Int -> @Bool = \b i =>
    if i >= @array_len b => @true else if @array_get b i != 0 => @false else all_zero b (i + 1)

# -- functions --------------------------------------------------------------------------

$ gen_all : Ctx -> @Vec Func -> @Int -> @Vec Body -> @Vec @Int -> TypeTab
    -> <Diag> { @Vec Body, @Vec @Int, TypeTab } = \c fs i bodies types tt =>
    if i >= @vec_len fs =>
        { bodies, types, tt }
    else
        let f = @vec_get fs i in
        let r = gen_func c f tt in
        let t = type_index r.1 (sig_of c.tg f.ty) in
        gen_all c fs (i + 1) (@vec_push bodies r.0) (@vec_push types t.0) t.1

# `__alec_main(argc, argv)` calls `main` with what it declares: nothing,
# `argc`, or `argc` and `argv`.
$ add_shim : Ctx -> Map @Str FnTy -> { @Vec Body, @Vec @Int, TypeTab }
    -> <Diag> { @Vec Body, @Vec @Int, TypeTab } = \c ftys g =>
    let mt = unwrap_or (FnTy.{ .ret = t_int, .params = List.Nil, .variadic = @false, .proto = @true })
        (get "main" ftys) in
    let np = len mt.params in
    let argc_ty = unwrap_or t_int (ARES.head mt.params) in
    let argc = local_get 0 ++ (vt_of c.tg argc_ty |> \ | ValT.I64 => op 172 | _ => "") in
    let args = (if np >= 1 => argc else "")
        ++ (if np >= 2 => local_get 1 else "")
        ++ (if np >= 3 => (if c.tg.wasm64 => i64_const 0 else i32_const 0) else "") in
    let ret =
        if is_void mt.ret =>
            i32_const 0
        else
            (vt_of c.tg mt.ret |> \ | ValT.I64 => op 167 | _ => "")
    in
    let code = args ++ call_op (unwrap_or 0 (get "main" c.fidx)) ++ ret in
    let sig = Sig.{ .params = [ValT.I32, ptr_vt c.tg], .results = [ValT.I32] } in
    let t = type_index g.2 sig in
    { @vec_push g.0 Body.{ .locals = @vec_new {}, .code = code }, @vec_push g.1 t.0, t.1 }
