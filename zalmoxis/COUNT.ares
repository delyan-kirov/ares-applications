$ @mod COUNT

#-
 - \file COUNT.ares
 - \info Classifies each line of a file as code, comment or blank. A line with
 -       anything outside a comment is code (a string is code); a line with
 -       only comments, or inside a block comment, is a comment; a line of
 -       whitespace is blank.
 -
 -       The scanner never walks a line byte by byte in Ares: `@array_scan`
 -       jumps to the next byte that could start a token (or end the line), so
 -       a plain line of code costs two scans and never reaches the scanner.
 -       The loops take curried `@Int` parameters and return one packed `@Int`,
 -       which the native backend keeps unboxed, so a line allocates nothing.
 -#

$ @import STR
$ @import VEC

# A language's comment and string syntax, with the scan masks built once.
# Block comments and quotes are parallel vectors: `opens[k]` ends at
# `closes[k]`. A line that holds nothing but a `docs` marker (an empty `///`)
# is blank. `prose` counts every non-blank line as a comment (Markdown).
$ Syntax : @struct =
    line: @Vec @Str,
    docs: @Vec @Str,
    opens: @Vec @Str,
    closes: @Vec @Str,
    nested: @Bool,
    qopens: @Vec @Str,
    qcloses: @Vec @Str,
    prose: @Bool,
    any: @Str,
    nl: @Str,
    solid: @Str,
    bstart: @Str,
    qstart: @Str,
    lstart: @Str,
    bmasks: @Vec @Str,
    qmasks: @Vec @Str,

$ Counts : @struct =
    code: @Int,
    comments: @Int,
    blanks: @Int,

# The scan masks for a language: `any` stops at the first byte of every
# opener and at a backslash, a block's mask at its closer (and its opener,
# when blocks nest), a quote's at its closer and at a backslash. Every mask
# stops at a newline. A backslash escapes the next byte in code as well as in
# a string, as tokei reads it, so the quote of `'\"'` opens no string. `solid`
# is every byte but whitespace (the newline is whitespace). `bstart`,
# `qstart` and `lstart` mark the first bytes of block openers, quotes and line
# comments, so a byte rules out whole lists of openers at a glance.
$ syntax : {
    line: @Vec @Str,
    docs: @Vec @Str,
    blocks: @Vec { @Str, @Str },
    nested: @Bool,
    quotes: @Vec { @Str, @Str },
    prose: @Bool
} -> Syntax =
    let opens = map (\b => b.0) blocks in
    let closes = map (\b => b.1) blocks in
    let qopens = map (\q => q.0) quotes in
    let qcloses = map (\q => q.1) quotes in
    let firsts = \toks => foldl (\acc t => acc ++ from_byte (at t 0)) "" toks in
    let any = byte_set <| "\n\\" ++ firsts line ++ firsts opens ++ firsts qopens in
    let bmasks =
        map (\b =>
            byte_set <| "\n" ++ from_byte (at b.1 0) ++ (if nested => from_byte (at b.0 0) else ""))
            blocks
    in
    let qmasks = map (\q => byte_set <| "\n\\" ++ from_byte (at q.1 0)) quotes in
    let nl = byte_set "\n" in
    let solid = byte_set_not " \t\r\n\x0b\x0c" in
    let bstart = byte_set <| firsts opens in
    let qstart = byte_set <| firsts qopens in
    let lstart = byte_set <| firsts line in
    Syntax.{
        line,
        docs,
        opens,
        closes,
        nested,
        qopens,
        qcloses,
        prose,
        any,
        nl,
        solid,
        bstart,
        qstart,
        lstart,
        bmasks,
        qmasks
    }

# A UTF-8 byte-order mark is not part of the first line.
$ count : Syntax -> @Str -> Counts = \syn s =>
    let start = if starts_with s "\xef\xbb\xbf" => 3 else 0 in
    if syn.prose => scan_prose syn s start 0 0 else lines syn s start 0 0 0 0

# ---- lines ----

# Line by line from `pos`, in scanner state `st`: `mode + 4 * (k + 256 *
# depth)`, where mode is 0 in code, 1 in block comment `k` at nesting `depth`,
# 2 in string `k`.
$ lines : Syntax -> @Str -> @Int -> @Int -> @Int -> @Int -> @Int
    -> Counts = \syn s pos st code comments blanks =>
    if pos >= @array_len s =>
        Counts.{ code, comments, blanks }
    else
        let r = scan_line syn s pos st in
        let next = r / 1048576 + 1 in
        let after = (r % 1048576) / 4 in
        r % 4 |> \
            | 1 => lines syn s next after (code + 1) comments blanks
            | 2 => lines syn s next after code (comments + 1) blanks
            | _ => lines syn s next after code comments (blanks + 1)

# One line from `pos`: its end, its class (0 blank, 1 code, 2 comment) and the
# state the next line starts in, packed as `eol * 2^20 + 4 * state + class`. A
# line in code with nothing on it that could open a comment or a string is
# settled here by two scans.
$ scan_line : Syntax -> @Str -> @Int -> @Int -> @Int = \syn s pos st =>
    if st != 0 =>
        slow syn s pos st
    else
        let j = @array_scan s pos syn.any in
        if j >= @array_len s =>
            slow syn s pos st
        else if @array_get s j != 10 =>
            slow syn s pos st
        else if @array_scan s pos syn.solid < j =>
            j * 1048576 + 1
        else
            j * 1048576

# A line that starts inside a block comment is a comment whatever follows the
# close, as tokei counts it.
$ slow : Syntax -> @Str -> @Int -> @Int -> @Int = \syn s pos st =>
    let eol = @array_scan s pos syn.nl in
    let r = step syn s pos eol (st % 4) ((st / 4) % 256) (st / 1024) 0 0 in
    if st % 4 == 1 => eol * 1048576 + r - r % 4 + 2 else eol * 1048576 + r

$ pack : @Int -> @Int -> @Int -> @Int -> @Int = \class mode k depth =>
    class + 4 * (mode + 4 * (k + 256 * depth))

$ classify : @Int -> @Int -> @Int = \has_code has_comment =>
    if has_code == 1 => 1 else if has_comment == 1 => 2 else 0

# The scanner: line [i, eol) from `mode` (0 code, 1 in block comment `k` at
# nesting `depth`, 2 in string `k`), with `has_code` / `has_comment` saying
# what the line held before `i`. Its result packs the line's class with the
# state after it, `class + 4 * state`. Every move is a tail call of `step`
# itself, which the native backend makes a loop.
$ step : Syntax -> @Str -> @Int -> @Int -> @Int -> @Int -> @Int -> @Int -> @Int
    -> @Int = \syn s i eol mode k depth has_code has_comment =>
    mode |> \
        | 0 =>
            let j = @array_scan s i syn.any in
            let code = if @array_scan s i syn.solid < j => 1 else has_code in
            if j >= eol =>
                pack (classify code has_comment) 0 0 0
            else if @array_get s j == 92 =>
                step syn s (j + 2) eol 0 0 0 1 has_comment
            else
                let c = @array_get s j in
                let b = if @array_get syn.bstart c == 0 => 0 - 1 else token syn.opens s j 0 in
                let q = if @array_get syn.qstart c == 0 => 0 - 1 else token syn.qopens s j 0 in
                if b >= 0 =>
                    step syn s (j + @array_len (@vec_get syn.opens b)) eol 1 b 1 code 1
                else if q >= 0 =>
                    step syn s (j + @array_len (@vec_get syn.qopens q)) eol 2 q 0 1 has_comment
                else if @array_get syn.lstart c == 0 =>
                    step syn s (j + 1) eol 0 0 0 1 has_comment
                else if token syn.line s j 0 < 0 =>
                    step syn s (j + 1) eol 0 0 0 1 has_comment
                else if code == 0 && has_comment == 0 && empty_doc syn s j eol =>
                    pack 0 0 0 0
                else
                    pack (classify code 1) 0 0 0
        | 1 =>
            let j = @array_scan s i (@vec_get syn.bmasks k) in
            if j >= eol =>
                pack (classify has_code 1) 1 k depth
            else if starts_at s j (@vec_get syn.closes k) =>
                let next = j + @array_len (@vec_get syn.closes k) in
                if depth == 1 =>
                    step syn s next eol 0 0 0 has_code 1
                else
                    step syn s next eol 1 k (depth - 1) has_code 1
            else if !syn.nested =>
                step syn s (j + 1) eol 1 k depth has_code 1
            else if starts_at s j (@vec_get syn.opens k) =>
                step syn s (j + @array_len (@vec_get syn.opens k)) eol 1 k (depth + 1) has_code 1
            else
                step syn s (j + 1) eol 1 k depth has_code 1
        # Inside a string every line is code. A backslash escapes the next
        # byte; one at the end of a line leaves the string open.
        | _ =>
            let j = @array_scan s i (@vec_get syn.qmasks k) in
            if j >= eol =>
                pack 1 2 k 0
            else if @array_get s j == 92 =>
                if j + 1 >= eol => pack 1 2 k 0 else step syn s (j + 2) eol 2 k 0 1 0
            else if starts_at s j (@vec_get syn.qcloses k) =>
                step syn s (j + @array_len (@vec_get syn.qcloses k)) eol 0 0 0 1 0
            else
                step syn s (j + 1) eol 2 k 0 1 0

# Whether the comment at `j` is a doc marker with nothing after it.
$ empty_doc : Syntax -> @Str -> @Int -> @Int -> @Bool = \syn s j eol =>
    let d = token syn.docs s j 0 in
    d >= 0 && @array_scan s (j + @array_len (@vec_get syn.docs d)) syn.solid >= eol

# The index of the first of `toks` (from `t` on) that starts at `j`, or -1.
$ token : @Vec @Str -> @Str -> @Int -> @Int -> @Int = \toks s j t =>
    if t >= @vec_len toks =>
        0 - 1
    else if starts_at s j (@vec_get toks t) =>
        t
    else
        token toks s j (t + 1)

$ starts_at : @Str -> @Int -> @Str -> @Bool = \s j tok => @array_match s j tok

# ---- prose ----

# Markdown and plain text: a line with anything on it is a comment.
$ scan_prose : Syntax -> @Str -> @Int -> @Int -> @Int -> Counts = \syn s pos comments blanks =>
    if pos >= @array_len s =>
        Counts.{ .code = 0, comments, blanks }
    else
        let eol = @array_scan s pos syn.nl in
        if @array_scan s pos syn.solid < eol =>
            scan_prose syn s (eol + 1) (comments + 1) blanks
        else
            scan_prose syn s (eol + 1) comments (blanks + 1)
