$ @mod WALK

#-
 - \file WALK.ares
 - \info Finds the files to count under a root, the way tokei's walker does by
 -       default: symbolic links are not followed, and the `.gitignore` and
 -       `.ignore` of every directory on the way down apply to what is below
 -       it. A later rule wins over an earlier one, and a deeper file's rules
 -       come later. A hidden entry (a leading `.`) is skipped unless a rule
 -       whitelists it (`!/.github/`). A file with no known extension is
 -       recognized by its `#!` line.
 -
 -       The walk is a parallel fold: the top levels of the tree are walked in
 -       parallel, a directory there being a task of its own with its own
 -       state, which visits each file as it finds it; states are merged as
 -       the tasks are joined. A task copies the rules it inherits first,
 -       since rules the tasks shared would be counted atomically on every
 -       read.
 -#

$ with IO
$ with STR
$ with VEC
$ with OPT
$ with PAR
$ with LANGS

# One ignore-file rule. `base` is the directory of its file, with a trailing
# `/`. An `anchored` rule (one with a `/` that is not trailing) matches the
# path below `base`; any other matches the entry's name at any depth. Most
# rules are a plain name or `*.ext`, so `shape` says how to test one without
# the glob matcher: 0 the name is `lit`, 1 it ends with `lit`, 2 it starts
# with `lit`, 3 match `glob`. A glob's literal ends, `pre` (up to its first
# special byte) and `post` (after its last), must begin and end any match, so
# they turn most entries away before the matcher runs.
$ Rule : @struct =
    base: @Str,
    glob: @Str,
    negate: @Bool,
    dir_only: @Bool,
    anchored: @Bool,
    shape: @Int,
    lit: @Str,
    pre: @Str,
    post: @Str,

# A file to count and its language (an index into `LANGS.table.langs`).
$ Found : @struct =
    path: @Str,
    lang: @Int,

# What a fold over the files does: a fresh state for a task, the files
# `files[lo, hi)` of one directory visited (in any order, on any thread), and
# two tasks' states combined. Files are handed over a directory at a time, so
# the walk itself calls no unknown function per entry and compiles to plain C.
$ Walker : @struct s =
    init: {} -> s,
    visit: s -> @Vec Found -> @Int -> @Int -> <@IO> s,
    merge: s -> s -> s,

# Fold `w` over every countable file under each root. `excludes` are extra
# rules, given as gitignore patterns, that apply under every root.
$ fold : { roots: @Vec @Str, excludes: @Vec @Str, w: Walker s } -> <@IO> s =
    walk_roots w (w.init {}) roots excludes 0

# The rules of an ignore file's text, for the directory `base` (with its
# trailing `/`). Blank lines and `#` comments hold none.
$ parse_rules : @Str -> @Str -> @Vec Rule = \base content => filter_map (rule base) (lines content)

# What `rules` say of the entry at `path` (its last segment `name`): the last
# rule that matches it decides.
$ Verdict : @union =
    Unmatched: {},
    Ignored: {},
    Whitelisted: {},

$ verdict : @Vec Rule -> @Str -> @Str -> @Bool -> Verdict = \rules path name is_dir =>
    verdict_from rules path name is_dir (@vec_len rules - 1)

# Whether the entry is skipped: ignored, or hidden and not whitelisted.
$ skipped : @Vec Rule -> @Str -> @Str -> @Bool -> @Bool = \rules path name is_dir =>
    verdict rules path name is_dir |> \
        | Verdict.Whitelisted => @false
        | Verdict.Ignored     => @true
        | Verdict.Unmatched   => at name 0 == 46

# A gitignore glob against a whole string: `*` and `?` stay within one `/`
# segment, `**` crosses them (`**/` also matches no directory at all), and
# `[...]` is a byte class with ranges, negated by a leading `!` or `^`.
$ glob : @Str -> @Str -> @Bool = \p s => glob_at p 0 s 0

$ @private

$ walk_roots : Walker s -> s -> @Vec @Str -> @Vec @Str -> @Int
    -> <@IO> s = \w st roots excludes i =>
    if i >= @vec_len roots =>
        st
    else
        walk_roots w (walk_root w st (trim_slash <| @vec_get roots i) excludes) roots excludes
            (i + 1)

$ walk_root : Walker s -> s -> @Str -> @Vec @Str -> <@IO> s = \w st root excludes =>
    let entries = list_dir root in
    if @vec_len entries > 0 =>
        walk w st root (VEC.map (rule_or_skip (root ++ "/")) excludes |> filter_map (\r => r))
            entries 0
    else
        let lang = LANGS.detect LANGS.table (base_name root) in
        if lang >= 0 => w.visit st [Found.{ .path = root, lang }] 0 1 else st

$ rule_or_skip : @Str -> @Str -> Option Rule = \base pattern => rule base pattern

# Directories this shallow get a task each; deeper ones are walked in their
# ancestor's task.
$ spawn_depth : @Int = 5

# One directory: its entries scanned in one loop that calls nothing unknown,
# then the subdirectories kept in this task walked, then its files visited.
$ walk : Walker s -> s -> @Str -> @Vec Rule -> @Vec Entry -> @Int
    -> <@IO> s = \w st dir inherited entries depth =>
    let rules =
        inherited |> with_file dir entries ".gitignore" |> with_file dir entries ".ignore"
    in
    let sc = scan_entries w dir rules entries depth 0 [] [] [] in
    let below = walk_deep w st rules sc.deep depth 0 in
    finish w below sc.files sc.pending

# What scanning a directory's entries collects: the files to visit, the
# subdirectories this task walks itself, and those handed to tasks.
$ Scan : @struct s =
    files: @Vec Found,
    deep: @Vec @Str,
    pending: @Vec (Future s),

$ walk_deep : Walker s -> s -> @Vec Rule -> @Vec @Str -> @Int -> @Int
    -> <@IO> s = \w st rules dirs depth i =>
    if i >= @vec_len dirs =>
        st
    else
        let path = @vec_get dirs i in
        walk_deep w (walk w st path rules (list_dir path) depth) rules dirs depth (i + 1)

# A task's own copy of `rules`, so that reading them counts nothing atomically.
$ own_rules : @Vec Rule -> @Vec Rule = \rules =>
    VEC.map (\r =>
        Rule.{
            .base = own r.base,
            .glob = own r.glob,
            .negate = r.negate,
            .dir_only = r.dir_only,
            .anchored = r.anchored,
            .shape = r.shape,
            .lit = own r.lit,
            .pre = own r.pre,
            .post = own r.post,
        }) rules

$ own : @Str -> @Str = \s => @array_slice s 0 (@array_len s)

$ with_file : @Str -> @Vec Entry -> @Str -> @Vec Rule
    -> <@IO> @Vec Rule = \dir entries name rules =>
    if any (\e => e.name == name) entries =>
        read_file (dir ++ "/" ++ name) |>
            \ | Option.Some.{ text } => append rules (parse_rules (dir ++ "/") text) | _ => rules
    else
        rules

# The entries of `dir` from `i` on.
$ scan_entries : Walker s -> @Str -> @Vec Rule -> @Vec Entry -> @Int -> @Int -> @Vec Found
    -> @Vec @Str -> @Vec (Future s)
    -> <@IO> Scan s = \w dir rules entries depth i files deep pending =>
    if i >= @vec_len entries =>
        Scan.{ files, deep, pending }
    else
        let e = @vec_get entries i in
        let path = dir ++ "/" ++ e.name in
        e.kind |> \
            | EntryKind.Dir =>
                if skipped rules path e.name @true =>
                    scan_entries w dir rules entries depth (i + 1) files deep pending
                else if depth < spawn_depth =>
                    let task = spawn (\_ =>
                        walk w (w.init {}) path (own_rules rules) (list_dir path) (depth + 1)) in
                    scan_entries w dir rules entries depth (i + 1) files deep
                        (@vec_push pending task)
                else
                    scan_entries w dir rules entries depth (i + 1) files (@vec_push deep path)
                        pending
            | EntryKind.File =>
                let lang = if skipped rules path e.name @false => 0 - 1 else language path e.name in
                if lang < 0 =>
                    scan_entries w dir rules entries depth (i + 1) files deep pending
                else
                    scan_entries w dir rules entries depth (i + 1)
                        (@vec_push files Found.{ path, lang }) deep pending
            | _ => scan_entries w dir rules entries depth (i + 1) files deep pending

# Files per visiting task: a directory with more is handed out in chunks this
# size, each a task with a fresh state, so a big flat directory is shared out.
$ chunk : @Int = 16

$ finish : Walker s -> s -> @Vec Found -> @Vec (Future s) -> <@IO> s = \w st files pending =>
    let n = @vec_len files in
    let own = if n <= chunk => w.visit st files 0 n else st in
    let tasks = if n <= chunk => pending else spawn_chunks w files 0 pending in
    foldl (\acc f => w.merge acc (PAR.get f)) own tasks

$ spawn_chunks : Walker s -> @Vec Found -> @Int -> @Vec (Future s)
    -> <@IO> @Vec (Future s) = \w files lo acc =>
    if lo >= @vec_len files =>
        acc
    else
        let hi = if lo + chunk > @vec_len files => @vec_len files else lo + chunk in
        let task = spawn (\_ => w.visit (w.init {}) files lo hi) in
        spawn_chunks w files hi (@vec_push acc task)

# By name, else (for a name with no extension) by the `#!` line.
$ language : @Str -> @Str -> <@IO> @Int = \path name =>
    let lang = LANGS.detect LANGS.table name in
    if lang >= 0 || STR.contains name "." =>
        lang
    else
        read_file path |>
            \ | Option.Some.{ body } => LANGS.detect_shebang LANGS.table body | _ => lang

$ verdict_from : @Vec Rule -> @Str -> @Str -> @Bool -> @Int
    -> Verdict = \rules path name is_dir i =>
    if i < 0 =>
        Verdict.Unmatched
    else
        let r = @vec_get rules i in
        if !(applies r path name is_dir) =>
            verdict_from rules path name is_dir (i - 1)
        else if r.negate =>
            Verdict.Whitelisted
        else
            Verdict.Ignored

$ applies : Rule -> @Str -> @Str -> @Bool -> @Bool = \r path name is_dir =>
    if r.dir_only && !is_dir =>
        @false
    else if r.anchored =>
        starts_with path r.base && shaped r (substr path (@array_len r.base) (@array_len path))
    else
        shaped r name

$ shaped : Rule -> @Str -> @Bool = \r target =>
    r.shape |> \
        | 0 => target == r.lit
        | 1 => ends_with target r.lit
        | 2 => starts_with target r.lit
        | _ => starts_with target r.pre
            && ends_with target r.post
            && glob_at r.glob (@array_len r.pre) target (@array_len r.pre)

$ rule : @Str -> @Str -> Option Rule = \base line =>
    let t = trim_end line in
    if STR.is_empty t || at t 0 == 35 =>
        Option.None
    else
        let negate = at t 0 == 33 in
        let body = if negate => substr t 1 (@array_len t) else t in
        let dir_only = ends_with body "/" in
        let stem = if dir_only => substr body 0 (@array_len body - 1) else body in
        let anchored = STR.contains stem "/" in
        let glob = if starts_with stem "/" => substr stem 1 (@array_len stem) else stem in
        if STR.is_empty glob =>
            Option.None
        else
            let k = shape glob anchored in
            let n = @array_len glob in
            let first = @array_scan glob 0 metas in
            let last = last_meta glob (n - 1) in
            let pre = substr glob 0 first in
            let post = if last < 0 => "" else substr glob (last + 1) n in
            Option.Some.{
                Rule.{ base, glob, negate, dir_only, anchored, .shape = k.0, .lit = k.1, pre, post }
            }

$ last_meta : @Str -> @Int -> @Int = \g i =>
    if i < 0 => i else if @array_get metas (at g i) != 0 => i else last_meta g (i - 1)

# How `rule` can test a glob (see `Rule`). A `*` must not cross a `/`, so the
# suffix and prefix shapes are only for a rule matched against a bare name.
$ shape : @Str -> @Bool -> { @Int, @Str } = \g anchored =>
    let n = @array_len g in
    if !(has_meta g 0 n) =>
        { 0, g }
    else if anchored =>
        { 3, "" }
    else if n > 1 && at g 0 == 42 && !(has_meta g 1 n) =>
        { 1, substr g 1 n }
    else if n > 1 && at g (n - 1) == 42 && !(has_meta g 0 (n - 1)) =>
        { 2, substr g 0 (n - 1) }
    else
        { 3, "" }

# Whether `g[i, n)` holds a byte the glob matcher treats specially.
$ has_meta : @Str -> @Int -> @Int -> @Bool = \g i n => @array_scan g i metas < n

$ metas : @Str = byte_set "*?[\\"

$ trim_end : @Str -> @Str = \s => substr s 0 (trim_end_at s (@array_len s))

$ trim_end_at : @Str -> @Int -> @Int = \s n =>
    if n > 0 && (at s (n - 1) == 32 || at s (n - 1) == 13 || at s (n - 1) == 9) =>
        trim_end_at s (n - 1)
    else
        n

$ trim_slash : @Str -> @Str = \p =>
    if @array_len p > 1 && ends_with p "/" => trim_slash (substr p 0 (@array_len p - 1)) else p

$ base_name : @Str -> @Str = \p => base_from p (@array_len p - 1)

$ base_from : @Str -> @Int -> @Str = \p i =>
    if i < 0 => p else if at p i == 47 => substr p (i + 1) (@array_len p) else base_from p (i - 1)

# ---- glob ----

$ glob_at : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    if pi >= @array_len p =>
        si >= @array_len s
    else
        at p pi |> \
            | 42 =>
                if pi + 1 < @array_len p && at p (pi + 1) == 42 =>
                    double_star p (pi + 2) s si
                else
                    star p (pi + 1) s si
            | 63 => si < @array_len s && at s si != 47 && glob_at p (pi + 1) s (si + 1)
            | 91 => si < @array_len s && class_at p (pi + 1) s si
            | 92 => pi + 1 < @array_len p
                && si < @array_len s
                && at s si == at p (pi + 1)
                && glob_at p (pi + 2) s (si + 1)
            | c  => si < @array_len s && at s si == c && glob_at p (pi + 1) s (si + 1)

# `*`: the rest of the pattern at `si`, or after one more byte of this segment.
$ star : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    if glob_at p pi s si =>
        @true
    else if si < @array_len s && at s si != 47 =>
        star p pi s (si + 1)
    else
        @false

# `**`: like `*` across segments; `**/` may also stand for no directory.
$ double_star : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    if pi < @array_len p && at p pi == 47 => any_dirs p (pi + 1) s si else any_bytes p pi s si

$ any_dirs : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    if glob_at p pi s si =>
        @true
    else
        find_from s "/" si |> \ | Option.Some.{ j } => any_dirs p pi s (j + 1) | _ => @false

$ any_bytes : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    if glob_at p pi s si => @true else if si < @array_len s => any_bytes p pi s (si + 1) else @false

# `[...]` at pattern byte `pi` (just past the `[`) against byte `si`.
$ class_at : @Str -> @Int -> @Str -> @Int -> @Bool = \p pi s si =>
    let neg = pi < @array_len p && (at p pi == 33 || at p pi == 94) in
    let start = if neg => pi + 1 else pi in
    let close = class_end p (start + 1) in
    if close >= @array_len p =>
        @false
    else
        let hit = in_class p start close (at s si) in
        if hit != neg => glob_at p (close + 1) s (si + 1) else @false

# The `]` closing a class whose members start at `i` (a `]` first is a member).
$ class_end : @Str -> @Int -> @Int = \p i =>
    if i >= @array_len p || at p i == 93 => i else class_end p (i + 1)

$ in_class : @Str -> @Int -> @Int -> @Int -> @Bool = \p i close c =>
    if i >= close =>
        @false
    else if i + 2 < close && at p (i + 1) == 45 =>
        (c >= at p i && c <= at p (i + 2)) || in_class p (i + 3) close c
    else if at p i == c =>
        @true
    else
        in_class p (i + 1) close c
