$ @mod RAYLIB

# Friendly aliases for the C scalar types raylib uses, so the bindings read a
# little nicer. Transparent (`@alias`), so they interchange with the `@`-forms.
$ I32 : @alias = @Int32
$ U32 : @alias = @Nat32
$ U8 : @alias = @Nat8
$ F32 : @alias = @Float32

# ==========================================================================
# Surface used by the launcher (MAIN.thx): the constants and functions this
# app calls, gathered here. The types they use (Color, Vector2, Rectangle,
# Font, ...) stay grouped at the top; the rest of the generated file is below.
# ==========================================================================

# -- input / window constants --
$ flag_window_undecorated : I32 = 8
$ key_escape : I32 = 256
$ key_enter : I32 = 257
$ key_backspace : I32 = 259
$ key_down : I32 = 264
$ key_up : I32 = 265
$ key_page_up : I32 = 266
$ key_page_down : I32 = 267
$ key_kp_enter : I32 = 335
$ mouse_button_left : I32 = 0
$ texture_filter_bilinear : I32 = 1

# -- window & lifecycle --
$ initWindow : { p0: I32, p1: I32, p2: @Str } -> {} = @extern "C" "InitWindow" "bin/libraylib.so"
$ closeWindow : {} -> {} = @extern "C" "CloseWindow" "bin/libraylib.so"
$ windowShouldClose : {} -> U8 = @extern "C" "WindowShouldClose" "bin/libraylib.so"
$ setWindowSize : { p0: I32, p1: I32 } -> {} = @extern "C" "SetWindowSize" "bin/libraylib.so"
$ setTargetFPS : I32 -> {} = @extern "C" "SetTargetFPS" "bin/libraylib.so"
$ setConfigFlags : U32 -> {} = @extern "C" "SetConfigFlags" "bin/libraylib.so"

# -- drawing --
$ beginDrawing : {} -> {} = @extern "C" "BeginDrawing" "bin/libraylib.so"
$ endDrawing : {} -> {} = @extern "C" "EndDrawing" "bin/libraylib.so"
$ clearBackground : Color -> {} = @extern "C" "ClearBackground" "bin/libraylib.so"
$ drawLine : { p0: I32, p1: I32, p2: I32, p3: I32, p4: Color } -> {} =
    @extern "C" "DrawLine" "bin/libraylib.so"
$ drawRectangle : { p0: I32, p1: I32, p2: I32, p3: I32, p4: Color } -> {} =
    @extern "C" "DrawRectangle" "bin/libraylib.so"
$ drawRectangleRounded : { p0: Rectangle, p1: F32, p2: I32, p3: Color } -> {} =
    @extern "C" "DrawRectangleRounded" "bin/libraylib.so"
$ drawTextEx : { p0: Font, p1: @Str, p2: Vector2, p3: F32, p4: F32, p5: Color } -> {} =
    @extern "C" "DrawTextEx" "bin/libraylib.so"
$ measureTextEx : { p0: Font, p1: @Str, p2: F32, p3: F32 } -> Vector2 =
    @extern "C" "MeasureTextEx" "bin/libraylib.so"
$ loadFontEx : { p0: @Str, p1: I32, p2: @Ptr, p3: I32 } -> Font =
    @extern "C" "LoadFontEx" "bin/libraylib.so"
$ setTextureFilter : { p0: Texture2D, p1: I32 } -> {} =
    @extern "C" "SetTextureFilter" "bin/libraylib.so"

# -- input polling --
$ getMouseX : {} -> I32 = @extern "C" "GetMouseX" "bin/libraylib.so"
$ getMouseY : {} -> I32 = @extern "C" "GetMouseY" "bin/libraylib.so"
$ getMouseWheelMove : {} -> F32 = @extern "C" "GetMouseWheelMove" "bin/libraylib.so"
$ isMouseButtonPressed : I32 -> U8 = @extern "C" "IsMouseButtonPressed" "bin/libraylib.so"
$ getCharPressed : {} -> I32 = @extern "C" "GetCharPressed" "bin/libraylib.so"
$ isKeyPressed : I32 -> U8 = @extern "C" "IsKeyPressed" "bin/libraylib.so"
$ isKeyPressedRepeat : I32 -> U8 = @extern "C" "IsKeyPressedRepeat" "bin/libraylib.so"

# skipped enum bool (name is not a Thrax type)
$ Vector2 : @struct @extern "C" = x: F32, y: F32,
$ Vector3 : @struct @extern "C" = x: @Float32, y: @Float32, z: @Float32,
$ Vector4 : @struct @extern "C" = x: @Float32, y: @Float32, z: @Float32, w: @Float32,
$ Quaternion : @alias = Vector4
$ Matrix : @struct @extern "C" =
    m0: @Float32,
    m4: @Float32,
    m8: @Float32,
    m12: @Float32,
    m1: @Float32,
    m5: @Float32,
    m9: @Float32,
    m13: @Float32,
    m2: @Float32,
    m6: @Float32,
    m10: @Float32,
    m14: @Float32,
    m3: @Float32,
    m7: @Float32,
    m11: @Float32,
    m15: @Float32,
$ Color : @struct @extern "C" = r: U8, g: U8, b: U8, a: U8,
$ Rectangle : @struct @extern "C" = x: F32, y: F32, width: F32, height: F32,
$ Image : @struct @extern "C" =
    data: @Ptr,
    width: @Int32,
    height: @Int32,
    mipmaps: @Int32,
    format: @Int32,
$ Texture : @struct @extern "C" = id: U32, width: I32, height: I32, mipmaps: I32, format: I32,
$ Texture2D : @alias = Texture
$ TextureCubemap : @alias = Texture
$ RenderTexture : @struct @extern "C" = id: @Nat32, texture: Texture, depth: Texture,
$ RenderTexture2D : @alias = RenderTexture
$ NPatchInfo : @struct @extern "C" =
    source: Rectangle,
    left: @Int32,
    top: @Int32,
    right: @Int32,
    bottom: @Int32,
    layout: @Int32,
$ GlyphInfo : @struct @extern "C" =
    value: @Int32,
    offsetX: @Int32,
    offsetY: @Int32,
    advanceX: @Int32,
    image: Image,
$ Font : @struct @extern "C" =
    baseSize: I32,
    glyphCount: I32,
    glyphPadding: I32,
    texture: Texture2D,
    recs: @Ptr,
    glyphs: @Ptr,
$ Camera3D : @struct @extern "C" =
    position: Vector3,
    target: Vector3,
    up: Vector3,
    fovy: @Float32,
    projection: @Int32,
$ Camera : @alias = Camera3D
$ Camera2D : @struct @extern "C" =
    offset: Vector2,
    target: Vector2,
    rotation: @Float32,
    zoom: @Float32,
$ Mesh : @struct @extern "C" =
    vertexCount: @Int32,
    triangleCount: @Int32,
    vertices: @Ptr,
    texcoords: @Ptr,
    texcoords2: @Ptr,
    normals: @Ptr,
    tangents: @Ptr,
    colors: @Ptr,
    indices: @Ptr,
    boneCount: @Int32,
    boneIndices: @Ptr,
    boneWeights: @Ptr,
    animVertices: @Ptr,
    animNormals: @Ptr,
    vaoId: @Nat32,
    vboId: @Ptr,
$ Shader : @struct @extern "C" = id: @Nat32, locs: @Ptr,
$ MaterialMap : @struct @extern "C" = texture: Texture2D, color: Color, value: @Float32,
# skipped struct Material (array or bit-field member)
$ Transform : @struct @extern "C" = translation: Vector3, rotation: Quaternion, scale: Vector3,
$ ModelAnimPose : @alias = @Ptr
# skipped struct BoneInfo (array or bit-field member)
$ ModelSkeleton : @struct @extern "C" = boneCount: @Int32, bones: @Ptr, bindPose: ModelAnimPose,
$ Model : @struct @extern "C" =
    transform: Matrix,
    meshCount: @Int32,
    materialCount: @Int32,
    meshes: @Ptr,
    materials: @Ptr,
    meshMaterial: @Ptr,
    skeleton: ModelSkeleton,
    currentPose: ModelAnimPose,
    boneMatrices: @Ptr,
# skipped struct ModelAnimation (array or bit-field member)
$ Ray : @struct @extern "C" = position: Vector3, direction: Vector3,
$ RayCollision : @struct @extern "C" =
    hit: @Nat8,
    distance: @Float32,
    point: Vector3,
    normal: Vector3,
$ BoundingBox : @struct @extern "C" = min: Vector3, max: Vector3,
$ Wave : @struct @extern "C" =
    frameCount: @Nat32,
    sampleRate: @Nat32,
    sampleSize: @Nat32,
    channels: @Nat32,
    data: @Ptr,
# skipped struct rAudioBuffer (name is not a Thrax type)
# skipped struct rAudioProcessor (name is not a Thrax type)
$ AudioStream : @struct @extern "C" =
    buffer: @Ptr,
    processor: @Ptr,
    sampleRate: @Nat32,
    sampleSize: @Nat32,
    channels: @Nat32,
$ Sound : @struct @extern "C" = stream: AudioStream, frameCount: @Nat32,
$ Music : @struct @extern "C" =
    stream: AudioStream,
    frameCount: @Nat32,
    looping: @Nat8,
    ctxType: @Int32,
    ctxData: @Ptr,
# skipped struct VrDeviceInfo (array or bit-field member)
# skipped struct VrStereoConfig (array or bit-field member)
$ FilePathList : @struct @extern "C" = count: @Nat32, paths: @Ptr,
# skipped struct AutomationEvent (array or bit-field member)
$ AutomationEventList : @struct @extern "C" = capacity: @Nat32, count: @Nat32, events: @Ptr,
$ ConfigFlags : @alias = @Int32
$ flag_vsync_hint : @Int32 = 64
