# Algebraic effects as state machines
#
# Mutable-looking state with no mutation

$ @mod MAIN

$ with STR
$ with HOST

$ State : @effect =
    get : {} -> @Int,
    put : @Int -> {},

$ runState : ({} -> <State> @Int) -> @Int -> @Int = \action s0 =
    let
        h =
            do action {}
            ctl k
            | get u => \s = k s s
            | put n => \s = k {} n
            | x     => \s = x
    in
        h s0

$ counter : {} -> <State> @Int =
    let
        x = get {},
        _ = put <| x + 1,
        y = get {},
    in
        x + y

$ @main : @Vec @Str -> <@IO> @Int = \args =
    print "counter from 10 = ?(runState counter 10)";
    0
