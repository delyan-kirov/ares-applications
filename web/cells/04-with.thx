# Composing types with `with`
#
# You can copy a type's fields or variants into another with `with`.
# The fields of a struct can also be exported using `with`.

$ @mod MAIN

$ with STR
$ with HOST

$ Point : @struct =
    x: @Int,
    y: @Int,

$ Point3 : @struct =
    with Point #- inserts x: @Int, y: @Int -#,
    z: @Int,

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    let
        p = Point3.{ .x = 1, .y = 2, .z = 3 }
    in with p in
        print "x + y + z = ?(x + y + z)";
        0
