# Sequences
#
# `[a, b, c]` builds a `@Vec`, the default sequence; `h :: t` prepends, `[]`
# is empty. Patterns mirror the sugar: `| []` and `| h :: t` walk a sequence
# one element at a time, and together they cover every one, so no catch-all
# arm is needed.

$ @mod MAIN

$ with STR
$ with HOST

$ sum : @Vec @Int -> @Int = \xs =
	is xs
		| [] => 0
		| h :: t => h + sum t

$ @main : @Vec @Str -> <@IO> @Int = \args =
	let xs = [1, 2, 3, 4, 5] in
	HOST.print <| "sum [1..5] = " ++ STR.from_int (sum xs);
	0
