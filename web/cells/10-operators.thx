# Operators are ordinary functions
#
# Most operators are extendable by defining their interface
# for a custom type.

$ @mod MAIN

$ with STR
$ with HOST

$ Money : @struct =
    cents: @Int,

$ impl_IAdd_for_Money : IAdd Money = 
   .{ .add = \a b => Money.{ .cents = a.cents + b.cents } }

$ show : Money -> @Str = \m =>
    "$?(m.cents / 100).?(m.cents % 100)"

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    let
        paid = Money.{ .cents = 150 } + Money.{ .cents = 99 }
    in
        print "1.50 + 0.99 = ?(show paid)";
        0
