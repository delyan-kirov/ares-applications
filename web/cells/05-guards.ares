# Pattern guards
#
# Match over a sum type using `with`. Additionally boolean guards
# are supported using `if` after the pattern.

$ @mod MAIN

$ @import STR
$ @import HOST

$ sign : @Int -> @Str = \n =>
    n |> \
        | m if m > 0 => "positive"
        | m if m < 0 => "negative"
        | _          => "zero"

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    (
        for [
            "sign  7 = ?(sign 7)",
            "sign -3 = ?(sign (- 3))",
            "sign  0 = ?(sign 0)",
        ] \i => print i
    );
    0
