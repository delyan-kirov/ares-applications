# Copying a type's members
#
# A `&` entry in a declaration runs a generator at build time and puts the
# fields or variants it builds in its place. `fields_of` copies another struct's.

$ @mod MAIN

$ @import STR
$ @import HOST
$ @import DERIVE

$ Point : @struct =
    x: @Int,
    y: @Int,

# The `&` entry inserts x: @Int, y: @Int.
$ Point3 : @struct =
    &DERIVE.fields_of "Point",
    z: @Int,

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    let p = Point3.{ .x = 1, .y = 2, .z = 3 } in print "x + y + z = ?(p.x + p.y + p.z)"; 0
