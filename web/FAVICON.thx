$ @mod MAIN

# \file FAVICON.thx
# \info Generates the site icon from geometry: an equilateral triangle, its
#       circumcircle and incircle, and the six small triangles its medians cut
#       it into.
#
#       The drawing strategy: nothing is stroked. A design is a background and
#       a stack of layers, each a color and a set of figures. A layer covers a
#       point when the point lies inside an odd number of its figures (the
#       even-odd rule), so every edge in the picture is an exact boundary and
#       nothing overlaps. A missing background or layer color is transparency:
#       a colorless layer erases what is under it. The same layers are written as vector SVG and
#       rendered to a raster that ffmpeg scales down to the PNG sizes browsers
#       ask for. Run from web/, optionally naming a design (default `site`):
#           thrax build FAVICON.thx && thrax-out/FAVICON [site|pinwheel]

$ with STR
$ with IO
$ with MATH
$ with VEC
$ with OPT

$ Rgb : @struct =
    r: @Int,
    g: @Int,
    b: @Int,

$ Point : @alias = { Real, Real }

$ Figure : @union =
    Disc: { cx: Real, cy: Real, radius: Real },
    Tri: { a: Point, b: Point, c: Point },

$ Layer : @struct =
    color: Option Rgb,
    figures: @Vec Figure,

$ Design : @struct =
    background: Option Rgb,
    layers: @Vec Layer,

$ navy : Rgb = Rgb.{ .r = 0, .g = 0, .b = 128 }
$ gold : Rgb = Rgb.{ .r = 245, .g = 197, .b = 66 }
$ bright_navy : Rgb = Rgb.{ .r = 30, .g = 64, .b = 175 }

# ---- geometry ----

# Lengths are in units of the icon's side. The triangle's centroid,
# circumcenter and incenter coincide, so every figure shares this center, and
# the inradius of an equilateral triangle is half its circumradius.
$ cx : Real = 0.5
$ cy : Real = 0.5
$ circumradius : Real = 0.47
$ inradius : Real = circumradius / 2.0

# The point at distance `d` from the center in direction `k`, counted in thirds
# of a turn from straight up (y grows downward). Whole `k` are the vertices,
# and `k + 0.5` is the midpoint of the side between vertices `k` and `k + 1`.
$ polar : Real -> Real -> Point = \k d =>
    let a = 0.0 - pi / 2.0 + 2.0 * pi * k / 3.0 in { cx + d * cos a, cy + d * sin a }

$ vertex : Real -> Point = \k => polar k circumradius

$ side_midpoint : Real -> Point = \k => polar (k + 0.5) inradius

$ circumcircle : Figure = Figure.Disc.{ cx, cy, circumradius }
$ incircle : Figure = Figure.Disc.{ cx, cy, inradius }
$ triangle : Figure = Figure.Tri.{ vertex 0.0, vertex 1.0, vertex 2.0 }

# The medians cut the triangle into six small triangles, each with a corner at
# the center, one at a vertex and one at a side's midpoint. Every other one,
# taken as a figure, makes them alternate.
$ wedges : @Vec Figure =
    let wedge = \k => Figure.Tri.{ { cx, cy }, vertex k, side_midpoint k } in
    [wedge 0.0, wedge 1.0, wedge 2.0]

# Pure even-odd over all the figures: the wedges alternate, and flip again
# inside the incircle, which makes a pinwheel.
$ pinwheel : Design = Design.{
    .background = Option.Some.{ navy },
    .layers = [Layer.{ Option.Some.{ gold }, append [circumcircle, triangle, incircle] wedges }],
}

# The site's icon: the same wedges without the pinwheel on a transparent
# ground, the incircle erased.
$ site : Design = Design.{
    .background = Option.None,
    .layers = [
        Layer.{ Option.Some.{ bright_navy }, append [circumcircle, triangle] wedges },
        Layer.{ Option.None, [incircle] },
    ],
}

# ---- vector: SVG ----

$ hex2 : @Int -> @Str = \n =>
    let digits = "0123456789abcdef" in
    @array_push (@array_push "" (@array_get digits (n / 16))) (@array_get digits (n % 16))

$ css : Rgb -> @Str = \c => "#?(hex2 c.r)?(hex2 c.g)?(hex2 c.b)"

# Each figure as a closed subpath. A circle is two half-circle arcs, since one
# arc cannot start and end at the same point.
$ subpath : Figure -> @Str = \f =>
    f |> \
    | Figure.Disc.{ x, y, r } =>
        "M?(x - r) ?(y)a?(r) ?(r) 0 1 0 ?(2.0 * r) 0a?(r) ?(r) 0 1 0 ?(0.0 - 2.0 * r) 0Z"
    | Figure.Tri.{ a, b, c } => "M?(a.0) ?(a.1)L?(b.0) ?(b.1)L?(c.0) ?(c.1)Z"

# One path per layer, in order, so later layers paint over earlier ones. An
# eraser wraps everything drawn so far in a mask that is black on its figures,
# so the accumulator carries a count to keep mask ids distinct.
$ svg_layer : { @Str, @Int } -> Layer -> { @Str, @Int } = \acc l =>
    let path = fold (\p f => p ++ subpath f) "" l.figures in
    l.color |> \
    | Option.Some.{ c } =>
        { acc.0 ++ "<path fill-rule=\"evenodd\" fill=\"?(css c)\" d=\"?(path)\"/>\n", acc.1 }
    | Option.None =>
        let id = "erase?(acc.1)" in
        {
            "<mask id=\"?(id)\"><rect width=\"1\" height=\"1\" fill=\"#fff\"/>"
                ++ "<path fill-rule=\"evenodd\" d=\"?(path)\"/></mask>\n"
                ++ "<g mask=\"url(#?(id))\">\n" ++ acc.0 ++ "</g>\n",
            acc.1 + 1,
        }

$ svg_background : Option Rgb -> @Str = \b =>
    b |> \
    | Option.Some.{ c } => "<rect width=\"1\" height=\"1\" fill=\"?(css c)\"/>\n"
    | Option.None       => ""

$ svg : Design -> @Str = \d =>
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1 1\">\n"
        ++ (fold svg_layer { svg_background d.background, 0 } d.layers).0
        ++ "</svg>\n"

# ---- raster: the even-odd rule, point by point ----

# Twice the signed area of p-q-s: its sign says which side of the line p-q the
# point s is on.
$ cross : Point -> Point -> Point -> Real = \p q s =>
    (q.0 - p.0) * (s.1 - p.1) - (q.1 - p.1) * (s.0 - p.0)

# Inside a triangle means on the same side of all three edges, whichever way
# round its corners are listed.
$ inside : Point -> Figure -> @Bool = \p f =>
    f |> \
        | Figure.Disc.{ x, y, r } => (p.0 - x) * (p.0 - x) + (p.1 - y) * (p.1 - y) < r * r
        | Figure.Tri.{ a, b, c } =>
            let u = cross a b p in
            let v = cross b c p in
            let w = cross c a p in
            if u > 0.0 && v > 0.0 && w > 0.0 => @true else u < 0.0 && v < 0.0 && w < 0.0

$ covers : Point -> Layer -> @Bool = \p l =>
    (fold (\n f => if inside p f => n + 1 else n) 0 l.figures) % 2 == 1

$ color_at : Design -> Point -> Option Rgb = \d p =>
    fold (\c l => if covers p l => l.color else c) d.background d.layers

# ffmpeg averages color channels without weighting them by alpha, so the color
# hidden in a clear pixel bleeds into the edge next to it. Clear pixels take
# the first color painted, which keeps a one-color icon's edges clean.
$ matte : Design -> Rgb = \d =>
    let first = fold (\m l => if is_some m => m else l.color) d.background d.layers in
    unwrap_or first Rgb.{ .r = 0, .g = 0, .b = 0 }

$ push_rgb : @Str -> Rgb -> @Str = \acc c => @array_push (@array_push (@array_push acc c.r) c.g) c.b

$ push_rgba : Rgb -> @Str -> Option Rgb -> @Str = \m acc o =>
    o |> \
    | Option.Some.{ c } => @array_push (push_rgb acc c) 255
    | Option.None       => @array_push (push_rgb acc m) 0

# One row of the image as RGBA bytes. Rows are built separately and joined once,
# since appending to a single growing string copies it on every byte.
$ pam_row : Design -> @Int -> @Int -> @Str = \d n row =>
    let pixel = 1.0 / real_of_int n in
    let m = matte d in
    let y = (real_of_int row + 0.5) * pixel in
    let go =
        \col acc =>
            if col == n =>
                acc
            else
                go (col + 1) (push_rgba m acc (color_at d { (real_of_int col + 0.5) * pixel, y }))
    in
    go 0 ""

# A PAM (P7): a tiny text header, then RGBA bytes row by row. ffmpeg
# reads it directly, so no image library is needed. Each pixel is one hard
# sample; the anti-aliasing comes from ffmpeg averaging many of them when it
# scales down.
$ pam : Design -> @Int -> @Str = \d n =>
    let go =
        \row rows => if row == n => rows else go (row + 1) (@vec_push rows (pam_row d n row))
    in
    let header = "P7\nWIDTH ?(n)\nHEIGHT ?(n)\nDEPTH 4\nMAXVAL 255\nTUPLTYPE RGB_ALPHA\nENDHDR\n" in
    header ++ STR.join "" (go 0 (@vec_new {}))

# ---- output ----

$ ffmpeg : @Str -> @Int -> @Str -> <@IO> @Int = \src side dst =>
    C.system "ffmpeg -loglevel error -y -i ?(src) -vf scale=?(side):?(side):flags=area ?(dst)"

$ design_named : @Str -> Option Design = \name =>
    name |> \
    | "site"     => Option.Some.{ site }
    | "pinwheel" => Option.Some.{ pinwheel }
    | _          => Option.None

$ @main : @Vec @Str -> <@IO> @Int = \args =>
    let name = if @vec_len args > 1 => @vec_get args 1 else "site" in
    design_named name |> \
    | Option.None       => eprintln "unknown design `?(name)`, expected `site` or `pinwheel`"; 2
    | Option.Some.{ d } => render d

$ render : Design -> <@IO> @Int = \d =>
    let master = "site/favicon-master.pam" in
    write_file "site/favicon.svg" (svg d);
    write_file master (pam d 720);
    let failed =
        ffmpeg master 32 "site/favicon.png" + ffmpeg master 180 "site/apple-touch-icon.png"
    in
    remove_file master;
    if failed == 0 =>
        println "wrote site/favicon.svg, site/favicon.png, site/apple-touch-icon.png"; 0
    else
        eprintln "ffmpeg failed"; 1
